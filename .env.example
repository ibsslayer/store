# GEMINI_API_KEY: Required for Gemini AI mobile phone advisor & comparison features.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloudflare R2 S3-Compatible Object Storage (Primary Storage Provider)
# Note: Keep all R2 credentials on the server. Never expose in frontend client code.
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="pakmobile-media"
R2_PUBLIC_BASE_URL="https://pub-xxxxxx.r2.dev"

# Supabase PostgreSQL Database & Authentication
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Initial Store Administrator Setup
ADMIN_INITIAL_EMAIL="ibsslayer@gmail.com"
ADMIN_INITIAL_PASSWORD="ChangeMeOnFirstLogin2026!"

# Official WhatsApp Support Number (e.g. +923001234567)
WHATSAPP_NUMBER="+923001234567"
