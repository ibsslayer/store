# GEMINI_API_KEY: Required for Gemini AI mobile phone advisor & comparison features.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet / backend is hosted.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Optional backend API origin when frontend is hosted on GitHub Pages
# e.g. https://ibs-slayer-api.onrender.com (leave empty when serving frontend + backend together)
VITE_API_BASE_URL=""

# SESSION_SECRET: Secret key used by Node.js backend to sign HMAC auth tokens.
SESSION_SECRET="change-this-to-a-long-random-secret"

# ALLOWED_ORIGINS: Comma-separated allowed frontend origins for CORS
ALLOWED_ORIGINS="https://ibsslayer.github.io,http://localhost:3000,http://localhost:5173"

# Backblaze B2 S3-Compatible Object Storage (Primary Storage Provider)
# Keep all B2 credentials on the server. Never expose in frontend client code.
B2_REGION="us-west-004"
B2_ENDPOINT="https://s3.us-west-004.backblazeb2.com"
B2_ACCESS_KEY_ID="your_b2_key_id"
B2_SECRET_ACCESS_KEY="your_b2_application_key"
B2_BUCKET_NAME="ibsslayer-media"
B2_PUBLIC_BASE_URL="https://f004.backblazeb2.com/file/ibsslayer-media"

# Supabase PostgreSQL Database & Authentication (Server-Side)
# Keep SUPABASE_SERVICE_ROLE_KEY strictly on the server.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Initial Store Administrator Setup
ADMIN_INITIAL_EMAIL="ibsslayer@gmail.com"
ADMIN_INITIAL_PASSWORD="ChangeMeOnFirstLogin2026!"

# Official WhatsApp Support Number (e.g. +923001234567)
WHATSAPP_NUMBER="+923001234567"
